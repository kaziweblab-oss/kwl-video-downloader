# KWL Video Downloader - Environment Variables Template

# Copy this file to .env and fill in your values
# .env is ignored by Git - never commit secrets!

# ------------------------------------------------------------
# KWL Nexus Integration (Phase 2)
# ------------------------------------------------------------
# Centralized account, plans, license management via KWL Nexus.
# KWL Nexus integration will be added in Phase 2.
# NEXUS_API_URL=https://api.kwl-nexus.com
# NEXUS_OAUTH_REDIRECT=http://127.0.0.1:8765/callback

# ------------------------------------------------------------
# Runtime Tool Paths (optional, auto-detected if empty)
# ------------------------------------------------------------
# Override yt-dlp, FFmpeg, ffprobe executable paths
# Leave empty to use managed versions (recommended)
KWL_YTDLP_PATH=
KWL_FFMPEG_PATH=
KWL_FFPROBE_PATH=

# ------------------------------------------------------------
# In-app Report System (Error / Suggestion / Feedback)
# ------------------------------------------------------------
# Where your team receives in-app reports.
# Optional: if no API key is set, reports are queued locally and
# delivered the next time the app runs with email configured.
REPORT_EMAIL_TO=support@kwl.com
REPORT_EMAIL_FROM=noreply@kwl.com
REPORT_EMAIL_API_KEY=re_xxx